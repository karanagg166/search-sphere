# Standalone Search Sphere. Copy to private .env; never commit credentials.
ENVIRONMENT=development
LOG_LEVEL=INFO
WEB_PORT=3000
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase PostgreSQL + pgvector and private object storage.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/search_sphere
DATABASE_URL_SYNC=postgresql://postgres:postgres@postgres:5432/search_sphere
VECTOR_STORE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
STORAGE_BACKEND=supabase
MAX_UPLOAD_SIZE_BYTES=20971520

# Server-only auth. Production rejects an absent/default JWT secret.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

# Cohere only. Confirm Trial/Evaluation before setting its SHA-256 fingerprint.
COHERE_API_KEY=
COHERE_TRIAL_KEY_SHA256=
COHERE_MONTHLY_CALL_LIMIT=900
COHERE_APPROVED_DATA_CLASSIFICATIONS=["public","synthetic"]
COHERE_SENSITIVE_APPROVAL_REF=
EMBEDDING_MODEL=embed-english-light-v3.0
SEMANTIC_CHUNKING_MODEL=embed-english-light-v3.0
RERANKER_MODEL_NAME=rerank-v3.5
IMAGE_CAPTION_MODEL=command-a-vision-07-2025
QUERY_REWRITE_MODEL=command-a-03-2025
RAG_GENERATION_MODEL=command-a-03-2025
ENABLE_IMAGE_CAPTIONING=true
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_TIMEOUT_SECONDS=35.0
QUERY_REWRITE_MAX_CONTEXT_MESSAGES=5
RAG_GENERATION_ENABLED=true
RAG_GENERATION_TIMEOUT_SECONDS=35.0
RAG_MAX_CONTEXT_CHUNKS=5
RAG_TEMPERATURE=0.1
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=480
CHUNK_OVERLAP_TOKENS=60
CONVERSATION_MAX_HISTORY_MESSAGES=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
MAX_QUERY_LENGTH=1000
# Compose disables this in the API and starts its worker independently.
RUN_INGESTION_WORKER=true
